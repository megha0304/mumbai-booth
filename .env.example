# JS Community Mumbai Event Booth Configuration
PORT=3000

# Optional: Set this if using Cloudflare Tunnel, ngrok, or localtunnel
# When set, the QR code will use this public URL so attendees can access from cellular data (5G/4G)
# e.g.: HOST_URL=https://booth.yourdomain.com
HOST_URL=

# Optional: Google Gemini API key for AI stylization
GEMINI_API_KEY=
